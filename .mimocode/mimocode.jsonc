{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "mcp": {
    // Supabase — 远程 MCP server，需 OAuth 认证
    // 文档: https://supabase.com/docs/guides/ai-tools/mcp
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true,
    },

    // Context7 — 实时获取库的最新文档
    // 文档: https://context7.com/
    // 需要设置 CONTEXT7_API_KEY 环境变量
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },

    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--extension"],
      "enabled": true,
      "environment": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "e7a16k32-S68TrQxmVvRKinKqBTyjfZhLoEiN9OMi2o",
      },
    },

    "longbridge": {
      "type": "remote",
      "url": "https://mcp.longbridge.com",
      "enabled": true,
    }
  },
}
