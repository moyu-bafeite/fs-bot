{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "mcp": {
    // Supabase — 远程 MCP server，需 OAuth 认证
    // 文档: https://supabase.com/docs/guides/ai-tools/mcp
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true
    },

    // shadcn/ui — 组件浏览、搜索、安装
    // 文档: https://ui.shadcn.com/docs/mcp
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "enabled": true
    },

    // Next.js DevTools — 运行时错误检测、路由查询、页面元数据
    // 要求 Next.js 16+，需先启动 dev server
    // 文档: https://nextjs.org/docs/app/guides/mcp
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },

    // Context7 — 实时获取库的最新文档
    // 文档: https://context7.com/
    // 需要设置 CONTEXT7_API_KEY 环境变量
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
